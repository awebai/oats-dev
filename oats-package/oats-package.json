{
  "package": "oats.dev",
  "version": "1.0.0",
  "description": "OATS-project development policy: the oats.review discipline plus a reference workspace profile for developing OATS itself.",
  "compatibility": {
    "oats": ">=0.19.0"
  },
  "capabilities": [
    "capabilities/oats-review"
  ],
  "configs": {
    "default": {
      "path": "configs/default/oats-config.yaml",
      "description": "OATS development workspace root",
      "default": true
    }
  },
  "dependencies": [
    "oats.okf@v1.4.1",
    "oats.aweb@v1.8.0",
    "oats.authoring@v1.0.0"
  ]
}
